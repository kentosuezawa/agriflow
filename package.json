{
  "name": "agriflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prestart": "npm run build",
    "start": "node src/server.js",
    "test": "npm run build && node --test test/*.test.js",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "test:e2e": "npm run build && playwright test",
    "seed": "node scripts/seed.mjs",
    "import:json": "node scripts/import-json.mjs",
    "test:integration": "npm run build && node --test test/integration/*.test.js",
    "measure": "npm run build && node scripts/measure.mjs",
    "verify:recovery": "node scripts/verify-recovery.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}
